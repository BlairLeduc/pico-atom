{"nodes": [{"id": "docs_hardware_notes", "label": "PicoCalc Hardware Notes", "file_type": "document", "source_file": "docs/hardware-notes.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_picocalc_carrier_board", "label": "PicoCalc Carrier Board", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PicoCalc is a carrier, not a computer; everything reaches the Pico module over three buses and a pair of PWM pins."}, {"id": "docs_hardware_notes_gpio_map", "label": "GPIO Map", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_missing_hardware_features", "label": "Four Things the Hardware Does Not Give You (no TE, no key IRQ, no DAC, no RTC)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_processor_boards", "label": "The Five Processor Boards", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Record physical board identity separately from the SDK build target; board=pico2 identifies compilation settings only."}, {"id": "docs_hardware_notes_pimoroni_pico_plus_2_w", "label": "Pimoroni Pico Plus 2 W", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L111", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_rp2040_vs_rp2350", "label": "RP2040 versus RP2350", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An RP2040 build is a different memory problem, not a slower one."}, {"id": "docs_hardware_notes_prefer_float_over_double", "label": "Prefer float over double", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L142", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "RP2350 has a single-precision FPU; RP2040 has none; a stray 2.0 literal promotes the whole expression to double."}, {"id": "docs_hardware_notes_erratum_rp2350_e9", "label": "Erratum RP2350-E9 (pull-down latch)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L151", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_sram_budget", "label": "SRAM Is the Scarce Resource", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L157", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "520 KiB must cover SRAM code, static buffers, both stacks, DMA and heap; keep fixed capacities in one header because they are traded against each other."}, {"id": "docs_hardware_notes_psram", "label": "PSRAM (Plus 2 W only)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L185", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use PSRAM for capacity, SRAM for the per-frame working set; verify with a real round trip before trusting it."}, {"id": "docs_hardware_notes_status_led", "label": "Status LED (pico_status_led)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L205", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On a W board the LED lives on the CYW43, so lighting it powers the radio; bring the driver up once."}, {"id": "docs_hardware_notes_cyw43_wifi", "label": "CYW43439 Wi-Fi", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L226", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_swd_uart_flashing", "label": "Getting Code On and Output Back (SWD, UF2, UART1)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L241", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_openocd_reset_halt_resume", "label": "OpenOCD reset halt + resume (core 1 lost on reset run)", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L259", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rp2350.cfg resets cores individually; reset run restarts core 0 which launches core 1, then OpenOCD resets core 1 into the bootrom. reset halt then resume holds both cores."}, {"id": "docs_hardware_notes_clocks_overclocking", "label": "Clocks, Voltage and Overclocking", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L279", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Five things derive from clk_sys and each breaks differently; CPU-bound code scales purely with clock."}, {"id": "docs_hardware_notes_clk_peri_fixup", "label": "clk_peri does not follow clk_sys", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L320", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "set_sys_clock_pll parks clk_peri at 48 MHz; re-apply SPI baud after every clock change."}, {"id": "docs_hardware_notes_spi_divider_table", "label": "SPI Divider Coarseness (300 MHz is free on both)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L327", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_psram_qmi_timing", "label": "PSRAM QMI Timing Computed Once", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L348", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_core_voltage_rail", "label": "Core Voltage Rail Sequencing", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L367", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_lcd_panel", "label": "320x320 LCD Panel (ST7789P/ST7365P, 480-row frame memory)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L381", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_lcd_spi_setup", "label": "LCD Wiring and SPI Setup (spi1)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L388", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_cs_high_40ns_rule", "label": "The 40 ns Chip-Select Rule", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L402", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "spi_set_format and D/CX write must precede CS low so the instructions themselves supply the CS-high gap; otherwise intermittent corrupt pixels that look like wiring faults."}, {"id": "docs_hardware_notes_lcd_initialisation", "label": "LCD Initialisation (MADCTL 0x48, COLMOD 0x55)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L421", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_caset_raset_windows", "label": "CASET/RASET Windows and RGB565", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L442", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Window setup is under a microsecond of wire, so splitting a present into many windows is nearly free."}, {"id": "docs_hardware_notes_dma_ping_pong_blit", "label": "Polled DMA Ping-Pong Line-Buffer Blit", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L462", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Poll rather than interrupt so audio owns its DMA IRQ; drain RX FIFO and clear overrun; restore 8-bit; leave interrupts enabled."}, {"id": "docs_hardware_notes_wire_cost", "label": "What the Wire Costs (4.0 Mpx/s effective)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L497", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cost is per pixel, not per present; narrowing the transmitted area buys back exactly its share."}, {"id": "docs_hardware_notes_hardware_vertical_scroll", "label": "Hardware Vertical Scroll (VSCRDEF/VSCSAD)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L551", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_readback_and_tearing", "label": "Readback and Tearing", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L570", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_framebuffer_models", "label": "Choosing a Framebuffer Model", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L588", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_band_renderer", "label": "Band Renderer / Compact Snapshot", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L597", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 256x192 1-bit snapshot is 6,144 bytes and can be expanded into one 640-byte RGB565 row; keep it immutable until the present finishes."}, {"id": "docs_hardware_notes_dirty_region_tracking", "label": "Dirty-Region Tile Tracking", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L606", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Over-mark rather than under-mark; snapshot and clear before sending."}, {"id": "docs_hardware_notes_backlight", "label": "LCD Backlight via Southbridge Register 0x05", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L629", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_pwm_audio_output", "label": "PWM Audio Output Stage (slice 5, GP26/27)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L640", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_carrier_and_sample_rate", "label": "Carrier and Sample Rate (73.2 kHz carrier, 36.6 kHz rate)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L655", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preserve the rational cadence 150,000,000/4096; integer reports are truncated and must not feed long-run timing."}, {"id": "docs_hardware_notes_chained_dma_audio_ring", "label": "Chained DMA Audio Ring", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L687", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Power-of-two aligned ring with hardware read wrap replays instead of playing adjacent RAM on IRQ starvation; re-arm both read address and transfer count."}, {"id": "docs_hardware_notes_audio_refill_deadline", "label": "Audio Refill Deadline (~3.5 ms) and IRQ Priority 0x40", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L713", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything about audio reduces to the refill deadline; DMA_IRQ_0 at 0x40 preempts default-priority handlers; refill path __not_in_flash_func."}, {"id": "docs_hardware_notes_software_psg_mixer", "label": "Software PSG Mixer Cost", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L733", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_spsc_queue", "label": "Lock-Free SPSC Queue", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L760", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_audio_bringup_findings", "label": "Three Audio Bring-up Findings (clicking)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L777", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_lcd_thread_context_only", "label": "LCD Only Touched from Thread Context", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L785", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A cursor timer drawing from IRQ forced the driver to mask interrupts, causing audio stutter; timers now set flags."}, {"id": "docs_hardware_notes_pcm_underrun_counting", "label": "Count PCM Underruns Separately from Late Refills", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L795", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A PCM queue can starve at 14,000-18,000 samples/s with zero late DMA refills; one counter cannot replace the other."}, {"id": "docs_hardware_notes_southbridge", "label": "Southbridge (STM32F103 keyboard MCU, I2C 0x1F, 10 kHz)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L816", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_southbridge_register_map", "label": "Southbridge Register Map", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L826", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_rst_register_hazard", "label": "RST Register 0x08 Read Resets the MCU", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L831", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_c64_raw_registers", "label": "C64_MTX / C64_JS Raw Keyboard Registers", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L844", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither covers the whole keyboard; C64_JS is reset to 0xFF every call so it looks broken; arrows only visible through the FIFO."}, {"id": "docs_hardware_notes_keyboard_polling", "label": "Keyboard Polling from the Frame Loop", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L866", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each transaction costs 4-5 ms; poll in thread context, guard the bus with a flag, drain many FIFO entries; the MCU resets its I2C after 2.5 s idle."}, {"id": "docs_hardware_notes_held_key_bitmap", "label": "Held-Key Bitmap from Press/Release Events", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L883", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The MCU's repeat cadence is a typing cadence; a game needs is-key-down state; canonicalize shifted releases."}, {"id": "docs_hardware_notes_mcu_shift_resolution", "label": "Shift Resolved in the MCU (swallowed chords)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L916", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_sd_card", "label": "SD Card on spi0", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L941", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use a temporary file and explicit publish/recovery; rename alone does not prove power-loss atomicity."}, {"id": "docs_hardware_notes_flash_xip_interrupt_hole", "label": "Internal Flash, XIP and the Interrupt Hole", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L964", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_die_temperature", "label": "Die Temperature Sensor", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L1000", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_measurement_discipline", "label": "Measure on Hardware, in the Mode You Ship", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L1047", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three authoritative-looking numbers were artefacts of harness mode; carry a control, expect 2% spread, one board per comparison, write results to a file."}, {"id": "docs_hardware_notes_xip_cache_instruction_fetch", "label": "XIP Cache Instruction Fetch Cost", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L1076", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_sram_hot_code_tiers", "label": "Hot Code to SRAM in Tiers (__not_in_flash_func)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L1082", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns halve every tier; each move relays the flash residue against the cache, so re-measure the whole profile."}, {"id": "docs_hardware_notes_data_placement", "label": "Where the Data Lives (PSRAM copy data-bound)", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L1113", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_small_memcpy_overhead", "label": "Small memcpy Calls Are Call Overhead", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L1128", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_dual_core_split", "label": "Core 1 Owns Slow Peripherals", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L1134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core 0 runs simulation and audio, core 1 the LCD and southbridge, with immutable frame handoff and a bounded input queue."}, {"id": "docs_hardware_notes_levers_in_order", "label": "Levers, in Order", "file_type": "concept", "source_file": "docs/hardware-notes.md", "source_location": "L1162", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_hardware_notes_sleep_us_core1_alarm", "label": "sleep_us on Core 1 Interrupts Core 0", "file_type": "rationale", "source_file": "docs/hardware-notes.md", "source_location": "L1177", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The default alarm pool's IRQ belongs to core 0; busy_wait_us_32 on core 1 cut core 0 cost per emulated instruction 1.11x."}, {"id": "docs_hardware_notes_sram_placement_inter