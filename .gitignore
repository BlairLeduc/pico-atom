modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Build trees
build/

# Third-party test suites, fetched by tools/fetch-test-suites.sh
test/suites/

# ROM images, which we cannot redistribute (README.md, "ROM images").
# roms/README.md says so in place and is kept.
roms/*
!roms/README.md

# macOS directory metadata
.DS_Store

# Rendered images test_mc6847_golden writes on a mismatch
*.actual.ppm

# Local run logs and scratch (tools/uart-log.sh); results worth keeping go in docs/.
out/

# graphify: keep the graph, its report, the community labels, the manifest
# and the semantic cache (the LLM extraction, costly to redo). The rest is
# machine-local or regenerated: interpreter/root paths, the HTML view
# (`graphify export html`), the AST cache and the per-run cost log.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/graph.html
graphify-out/cost.json
graphify-out/cache/ast/
graphify-out/cache/stat-index.json
